{
  "name": "wot-project",
  "version": "1.0.0",
  "description": "A smart chat bot using Web of Things (WoT) with AI capabilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "llm": "node dist/llmThing.js",
    "web": "node dist/web-server.js",
    "dev": "ts-node src/index.ts",
    "dev:llm": "ts-node src/llmThing.ts",
    "dev:web": "ts-node src/web-server.ts",
    "watch:start": "nodemon dist/index.js",
    "watch:llm": "nodemon dist/llmThing.js",
    "watch:web": "nodemon dist/web-server.js",
    "dev:all": "concurrently \"npm:watch\" \"npm:watch:start\" \"npm:watch:llm\" \"npm:watch:web\"",
    "index:wiki": "ts-node src/scripts/build_wiki_index.ts",
    "test:wot": "node test-wot-validation.js",
    "setup:security": "node setup-security.js"
  },
  "keywords": [
    "wot",
    "web-of-things",
    "iot",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/node": "^18.15.11",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.10.9",
    "eventsource": "^4.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.2"
  },
  "dependencies": {
    "@node-wot/binding-http": "^0.9.2",
    "@node-wot/binding-mqtt": "^0.9.2",
    "@node-wot/core": "^0.9.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@qdrant/js-client-rest": "^1.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express-session": "^1.18.2",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mqtt": "^5.15.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "wot-typescript-definitions": "^0.8.0-SNAPSHOT.23",
    "yargs": "^17.7.2"
  }
}
